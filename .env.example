# Optional local fallback for `bin/setup-cloudflare-hosting.sh`.
# Prefer Bitwarden Secrets Manager (no .env):
#   export BWS_ACCESS_TOKEN=... BWS_PROJECT_ID=...
#   bin/setup-cloudflare-hosting.sh
#
# Canonical script: mzworthington/edge-dns (this repo keeps a thin shim).
# Never commit `.env`. CI uses GitHub Actions secrets/vars.

# PULUMI_STACK=prod
# DOMAIN=mzworthington.co.uk
# WWW_DOMAIN=www.mzworthington.co.uk
# PAGES_PROJECT_NAME=mzworthington
# Or modern hostnames shape:
# PAGES_HOSTNAMES=mzworthington.co.uk,www.mzworthington.co.uk

# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# PULUMI_ACCESS_TOKEN=
# BWS_ACCESS_TOKEN=
# BWS_PROJECT_ID=

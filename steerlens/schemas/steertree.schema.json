{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steerlens.dev/schemas/steertree.schema.json",
  "title": "SteerTree",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "steerlens.dev/v1alpha1"
    },
    "kind": {
      "const": "SteerTree"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vision", "outcomes", "bets", "teams"],
      "properties": {
        "vision": { "type": "string", "minLength": 1 },
        "outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/outcome" }
        },
        "bets": {
          "type": "array",
          "items": { "$ref": "#/$defs/bet" }
        },
        "teams": {
          "type": "array",
          "items": { "$ref": "#/$defs/team" }
        },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" },
          "default": []
        },
        "decisionNotes": {
          "type": "array",
          "items": { "$ref": "#/$defs/decisionNote" },
          "default": []
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" },
          "default": []
        }
      }
    }
  },
  "$defs": {
    "statusOutcome": {
      "type": "string",
      "enum": ["on_track", "at_risk", "achieved", "abandoned"]
    },
    "statusBet": {
      "type": "string",
      "enum": ["proposed", "on_track", "at_risk", "stop_ready", "stopped", "done"]
    },
    "teamRole": {
      "type": "string",
      "enum": ["customer_facing", "shared_platform", "coaching_support"]
    },
    "provenance": {
      "type": "string",
      "enum": ["local", "backstage", "github", "entra", "catalog_file"]
    },
    "interactionMode": {
      "type": "string",
      "enum": ["uses_as_service", "works_together", "coaching"]
    },
    "recommendation": {
      "type": "string",
      "enum": ["start", "continue", "stop", "rescope"]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "status": { "$ref": "#/$defs/statusOutcome" },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric" },
          "default": []
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "unit": { "type": "string" },
        "current": { "type": ["number", "null"] },
        "baseline": { "type": ["number", "null"] },
        "target": { "type": ["number", "null"] },
        "interpretation": { "type": "string" }
      }
    },
    "bet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcomeId", "title", "successSignal", "killCriteria", "status"],
      "properties": {
        "id": { "type": "string" },
        "outcomeId": { "type": "string" },
        "title": { "type": "string" },
        "successSignal": { "type": "string" },
        "killCriteria": { "type": "string" },
        "status": { "$ref": "#/$defs/statusBet" },
        "fundedTeamIds": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "systemRefs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Optional ArchLens entityRefs — unused in Slice 1"
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "role", "provenance"],
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "$ref": "#/$defs/teamRole" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "externalRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/externalRef" },
          "default": []
        }
      }
    },
    "externalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "id"],
      "properties": {
        "system": {
          "type": "string",
          "enum": ["backstage", "github", "entra", "other"]
        },
        "id": { "type": "string" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromTeamId", "toTeamId", "mode"],
      "properties": {
        "fromTeamId": { "type": "string" },
        "toTeamId": { "type": "string" },
        "mode": { "$ref": "#/$defs/interactionMode" }
      }
    },
    "decisionNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recommendation", "title", "why", "nextStep"],
      "properties": {
        "id": { "type": "string" },
        "betId": { "type": ["string", "null"] },
        "recommendation": { "$ref": "#/$defs/recommendation" },
        "title": { "type": "string" },
        "why": { "type": "string" },
        "measured": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "affectedTeamIds": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "nextStep": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": { "type": "string" },
        "metricId": { "type": ["string", "null"] },
        "source": {
          "type": "string",
          "enum": ["sample", "manual", "github", "other"]
        },
        "note": { "type": "string" }
      }
    }
  }
}
